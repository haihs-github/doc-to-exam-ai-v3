# Created by Haihs on 11/11/2026
# Example environment for the API (copy to .env.local).
# Required in production, and for ANY NODE_ENV other than development/test (secrets >= 16 chars, TEACHER_SECRET_KEY >= 8)
# In development/test, leaving the secrets empty generates random secrets per process (they change on every restart)
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/doc_to_exam_db
JWT_SECRET=
API_KEY_ENCRYPTION_SECRET=
TEACHER_SECRET_KEY=
# NOTE: currently has no effect: the in-memory DB fallback is not implemented yet (loadEnv only parses it)
# Dev/test only; ignored in production
ALLOW_IN_MEMORY_DB=true
# Haihs: ghi chú mới thay cho NOTE "no effect" ở trên (đã lỗi thời, fallback đã được cài ở m1/api) - start
# UPDATE: the in-memory fallback EXISTS now. In development/test, when MONGODB_URI is empty the API starts
# mongodb-memory-server (data is lost on stop; first run downloads a mongod binary). It is always off in production.
# Haihs: ghi chú mới thay cho NOTE "no effect" ở trên (đã lỗi thời, fallback đã được cài ở m1/api) - end
# Haihs: ghi chú TRUST_PROXY cho rate limit - start
# Number of trusted reverse proxies in front of the app (X-Forwarded-For). Default: 1 in production, 0 elsewhere.
# Production MUST run behind exactly this many trusted proxies, or set TRUST_PROXY=0 (then all clients share one rate-limit IP bucket).
# TRUST_PROXY=1
# Haihs: ghi chú TRUST_PROXY cho rate limit - end
