# Created by Haihs on 11/11/2026
# Example environment for the API (copy to .env.local).
# Required in production, and for ANY NODE_ENV other than development/test (secrets >= 16 chars, TEACHER_SECRET_KEY >= 8)
# In development/test, leaving the secrets empty generates random secrets per process (they change on every restart)
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/doc_to_exam_db
JWT_SECRET=
API_KEY_ENCRYPTION_SECRET=
TEACHER_SECRET_KEY=
# NOTE: currently has no effect: the in-memory DB fallback is not implemented yet (loadEnv only parses it)
# Dev/test only; ignored in production
ALLOW_IN_MEMORY_DB=true
